#include <windows.h>

// Embed the application manifest (asInvoker + comctl32 v6 + DPI).
// CREATEPROCESS_MANIFEST_RESOURCE_ID (1) is the id Windows honours for an EXE.
// The path below must stay relative to the .rc file: rc.exe resolves it from
// the .rc's own directory, and an absolute build-machine path would break on
// any other checkout.
1 RT_MANIFEST "VirtualHIDTyper.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Virtual HID Inc."
            VALUE "FileDescription", "VirtualHIDTyper - Virtual HID keyboard text entry"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "VirtualHIDTyper"
            VALUE "OriginalFilename", "VirtualHIDTyper.exe"
            VALUE "ProductName", "VirtualHIDTyper"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
